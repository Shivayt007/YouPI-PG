# EasyPanel > service > Environment. Keep other existing secrets unchanged.
PUBLIC_BASE_URL=https://centrallinks-upi.o1wxup.easypanel.host
GATEWAY_PORT=8080
ADMIN_USERNAME=admin
# Choose your own password of at least 12 characters; do not commit it to GitHub.
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PRIVATE_PASSWORD
# Generate once; used to enroll the bank-alert phone. Keep stable across redeploys.
ANDROID_ENROLLMENT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SQLITE_DB_PATH=/app/data/youpi_pg.sqlite
USE_SQLITE_FALLBACK=true
# No CLOUDFLARE_DOMAIN, BASE_* URLs or Cloudflare tunnel are needed in this mode.
# Use only one EasyPanel HTTPS domain pointing to internal HTTP port 8080.
# Remove any EasyPanel-generated development .env file; process env is authoritative.
