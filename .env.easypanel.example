# Paste into EasyPanel > gateway > Environment; replace every CHANGE_ME value.
# Keep real secrets in EasyPanel, never in this GitHub file.
NODE_ENV=production

# REQUIRED by scripts/start.js, even when EasyPanel handles HTTPS instead of a tunnel.
# Bare root domain only: no https:// and no pay. prefix.
CLOUDFLARE_DOMAIN=example.com
DEPLOYMENT_PREFIX=pay
# Leave CLOUDFLARE_TUNNEL_COMMAND unset when using EasyPanel Domains.

# Use these exact hostnames in EasyPanel Domains, or change all of them together.
BASE_PAYMENT_API_URL=https://pay-api.example.com
BASE_CHECKOUT_URL=https://pay.example.com
BASE_ADMIN_URL=https://pay-admin.example.com
BASE_DEMO_STORE_URL=https://pay-store.example.com
GMAIL_REDIRECT_URI=https://pay-gmail.example.com/oauth/callback

CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_STORE_PORT=5000

USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=/app/data/youpi_pg.sqlite
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=CHANGE_ME_TO_64_RANDOM_HEX_CHARACTERS
JWT_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET
ANDROID_ENROLLMENT_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET
# Used when the default merchant is first seeded; retain this value across restarts.
COIN_STORE_WEBHOOK_SECRET=CHANGE_ME_TO_A_UNIQUE_WEBHOOK_SECRET

# Start with Android observer pairing; configure Gmail separately if required.
# This fork contains hardcoded Gmail OAuth redirects; see docs/EASYPANEL.md.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# INITIAL_ADMIN_EMAIL / INITIAL_ADMIN_PASSWORD are NOT authentication controls
# in this fork. Restrict admin routes at the reverse proxy before public access.
